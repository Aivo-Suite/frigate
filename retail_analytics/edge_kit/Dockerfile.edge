FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY requirements.intelbras.txt ./
RUN pip install --no-cache-dir -r requirements.intelbras.txt
COPY intelbras_edge.py edge_provisioner.py edge_counter.py crossing_counter.py retail_store.py visitor_store.py ./
ENV PYTHONUNBUFFERED=1
CMD ["python", "intelbras_edge.py"]
